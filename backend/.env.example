DATABASE_URL=postgresql+asyncpg://briefbiz:briefbiz@postgres:5432/briefbiz
REDIS_URL=redis://redis:6379/0
ELASTICSEARCH_URL=http://elasticsearch:9200
OPENROUTER_API_KEY=your-openrouter-api-key
LLM_MODEL=openrouter/free
# Optional overrides:
# OPENAI_API_KEY=
# LLM_BASE_URL=
# EMBEDDING_MODEL=
# NEWS_API_KEY=
# GOOGLE_TTS_KEY=
JWT_SECRET=change-me
# Optional email providers:
# RESEND_API_KEY=your-resend-api-key
# RESEND_FROM_EMAIL=briefbiz@example.com
# SENDGRID_API_KEY=your-sendgrid-api-key
# SENDGRID_FROM_EMAIL=briefbiz@example.com
APP_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost
ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_ISSUER=briefbiz-api
JWT_AUDIENCE=briefbiz-clients
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=10
