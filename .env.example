# Root environment bootstrap for BriefBiz.
# Copy backend values into backend/.env for local development.

# Backend
DATABASE_URL=postgresql+asyncpg://briefbiz:briefbiz@postgres:5432/briefbiz
REDIS_URL=redis://redis:6379/0
ELASTICSEARCH_URL=http://elasticsearch:9200
OPENROUTER_API_KEY=your-openrouter-api-key
LLM_MODEL=openrouter/free
OPENAI_API_KEY=
LLM_BASE_URL=
EMBEDDING_MODEL=
NEWS_API_KEY=
GOOGLE_TTS_KEY=
JWT_SECRET=change-me
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
APP_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost
ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_ISSUER=briefbiz-api
JWT_AUDIENCE=briefbiz-clients
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=10
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_ENABLE_MOCK_FALLBACK=false

# Frontend container / deployment
API_UPSTREAM=http://api:8000
